 #[test]
+fn commit_scatter_preserves_trace_floor_affixes_and_active_reuse() {
+    use merge::{MergeOptions, PairLayout};
+    let fixtures = [
+        counts(&[
+            ("ab", 1000),
+            ("cd", 900),
+            ("abcd", 20),
+            ("cdab", 15),
+            ("ababcdcd", 9),
+        ]),
+        counts(&[
+            ("aaaaaa", 23),
+            ("aaabaaa", 17),
+            ("abaaab", 11),
+            ("cdabcd", 7),
+        ]),
+        counts(&[
+            ("猫猫猫鱼", 19),
+            ("猫鱼猫鱼", 13),
+            ("abcdef", 7),
+            ("abcabc", 3),
+        ]),
+        counts(&[("baaba", 1), ("xyxyxy", 100)]),
+    ];
+    for words in &fixtures {
+        for flavor in 0..3 {
+            for floor in [1, 3, 100] {
+                let mut builder = BpeTrainer::builder()
+                    .vocab_size(48)
+                    .min_frequency(floor)
+                    .show_progress(false);
+                if flavor == 1 {
+                    builder = builder
+                        .continuing_subword_prefix("##".into())
+                        .end_of_word_suffix("</w>".into())
+                        .max_token_length(Some(9));
+                } else if flavor == 2 {
+                    builder = builder.end_of_word_suffix("a".into());
+                }
+                let trainer = builder.build();
+                let mut expected_trace = Vec::new();
+                let expected = trainer
+                    .do_train_observed(words, |pair, count, id| {
+                        expected_trace.push((pair, count, id));
+                    })
+                    .unwrap();
+                for workers in [1, 4] {
+                    for layout in [PairLayout::Grid, PairLayout::Whole] {
+                        let mut trace = Vec::new();
+                        let actual = train_with_merge_options(
+                            &trainer,
+                            words,
+                            workers,
+                            MergeOptions {
+                                single_producer_fast: true,
+                                direct_encoding: true,
+                                commit_scatter: true,
+                                group_births_in_commit: true,
+                                fast_shard_router: true,
+                                layout,
+                                ..Default::default()
+                            },
+                            Some(&mut |pair, count, id| trace.push((pair, count, id))),
+                        )
+                        .unwrap();
+                        assert_eq!(
+                            trace, expected_trace,
+                            "workers={workers} layout={layout:?} flavor={flavor} floor={floor}"
+                        );
+                        assert_eq!(actual, expected);
+                    }
+                }
+            }
+        }
+    }
+}
