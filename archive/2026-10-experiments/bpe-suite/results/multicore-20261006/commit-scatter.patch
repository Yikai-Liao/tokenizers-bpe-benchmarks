+    #[test]
+    fn commit_scatter_shared_retirement_is_unique() {
+        let count = AtomicU64::new(10_000);
+        let retired = (0..10_000)
+            .into_par_iter()
+            .map(|_| usize::from(subtract_shared(&count, 1, 9_001).unwrap()))
+            .sum::<usize>();
+        assert_eq!(retired, 1);
+        assert_eq!(count.load(AtomicOrdering::Relaxed), 9_000);
+    }
+
+    #[test]
+    fn commit_scatter_shared_subtraction_checks_full_width_and_underflow() {
+        let count = AtomicU64::new(u64::MAX);
+        assert!(!subtract_shared(&count, u64::MAX - 3, 2).unwrap());
+        assert_eq!(count.load(AtomicOrdering::Relaxed), 3);
+        assert!(subtract_shared(&count, 4, 2).is_err());
+        assert_eq!(count.load(AtomicOrdering::Relaxed), 3);
+        assert!(subtract_shared(&count, 2, 2).unwrap());
+        assert!(!subtract_shared(&count, u64::MAX, 2).unwrap());
+        assert_eq!(count.load(AtomicOrdering::Relaxed), 1);
+        assert_eq!(std::mem::size_of::<PairState<'_>>(), 24);
+    }
