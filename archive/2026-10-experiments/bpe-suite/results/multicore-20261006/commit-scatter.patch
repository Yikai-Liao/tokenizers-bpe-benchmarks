+        use tk_collections::{PositionChain, PositionChains, PositionEncodingScratch};
+        let execution = Execution::with_owners(4, 1, false).unwrap();
+        let arena = AllocationArena::new(4, 4096);
+        execution.pool.install(|| {
+            let mut chunks = Vec::new();
+            for chunk in 0..8 {
+                let mut chains = PositionChains::new();
+                let mut changes = Vec::new();
+                for index in 0..256 {
+                    let position = chunk * 256 + index;
+                    let bucket = (position % 3) as u32;
+                    let born = match bucket {
+                        0 => (3, 100),
+                        1 => (100, 4),
+                        _ => (5, 101),
+                    };
+                    let mut positions = PositionChain::default();
+                    chains.push(&mut positions, position as u64).unwrap();
+                    changes.push(PairChanges {
+                        removed_key: pair_key((1, 2)),
+                        removed_weight: 1,
+                        born_key: pair_key(born),
+                        born_weight: 3,
+                        positions,
+                        bucket,
+                    });
+                }
+                chunks.push(EventChunk::test(chains, changes, 4));
+            }
+            let events = MergeEvents { buckets: 3, chunks };
+            let mut routes = events.dispatch_births_with_router(ShardRouter::new(1, false));
+            routes[0].group_births(&events);
+            let ranges = cold_ranges(&events, &routes[0], 512);
+            assert_eq!(
+                ranges.len(),
+                3,
+                "one mutable owner supplies three complete cold tasks"
+            );
+            assert_eq!(ranges.iter().map(|range| range.len()).sum::<usize>(), 2048);
+            for range in ranges {
+                let indices = &routes[0].births[range];
+                let buckets: Vec<_> = indices
+                    .iter()
+                    .map(|&index| {
+                        let reference = &routes[0].changes[index];
+                        events.chunks[reference.chunk].changes[reference.index()].bucket
+                    })
+                    .collect();
+                assert!(buckets.iter().all(|bucket| *bucket == buckets[0]));
+            }
+            let make_index = || {
+                let mut states = AHashMap::new();
+                states.insert(
+                    pair_key((1, 2)),
+                    PairState {
+                        ledger_count_bits: 3000_u64.into(),
+                        positions: SortedPositions::from_sorted(
+                            &[7],
+                            &mut PositionEncodingScratch::default(),
+                            &arena.lease(0),
+                        )
+                        .unwrap(),
+                    },
+                );
+                PairIndex::from_initial_pairs(
+                    InitialPairTable {
+                        shards: vec![states],
+                        weighted_mass: 3000,
+                        maximum_word_weight: 1,
+                    },
+                    IdentityPolicy::Fresh,
+                    1500,
+                )
+                .unwrap()
+            };
+            let mut original = make_index();
+            let mut scatter = make_index();
+            scatter.configure_scatter(true);
+            // The training coordinator restores speculative prefixes before
+            // every commit. The fixture skips selection but must keep that gate.
+            original.end_selection();
+            scatter.end_selection();
+            original
+                .commit_merges(&events, 102, &execution, &arena)
+                .unwrap();
+            scatter
+                .commit_merges(&events, 102, &execution, &arena)
+                .unwrap();
+            assert!(!scatter.shards[0].states.contains_key(&pair_key((1, 2))));
+            assert_eq!(scatter.shards[0].states.len(), 3);
+            for (&key, state) in &original.shards[0].states {
+                let actual = &scatter.shards[0].states[&key];
+                assert_eq!(actual.count(), state.count());
+                assert_eq!(
+                    actual.positions.iter().collect::<Vec<_>>(),
