+//! Split Fresh commit by the work being performed, not by mutable map ownership.
+//!
+//! Maps and position lists remain structurally frozen during shared count updates
+//! and cold-cohort construction. Rayon joins every reader before the original
+//! owners erase retired states, insert completed states and publish heap entries.
+//! No task nests pool work while holding worker-local scratch or arena leases.
+use super::*;
+use crate::trainers::bpe::engine::{
+    execution::Execution,
+    merge::{MergeEvents, OwnerRoute},
+};
+use std::ops::Range;
+use tk_collections::{AllocationArena, IdAccumulator};
+
+const REMOVAL_RECORDS_PER_TASK: usize = 2048;
+const MIN_COLD_REFERENCES_PER_TASK: usize = 512;
+
+/// Only the successful transition below the selection floor retires a state.
+/// Later decrements see the retired count and reproduce Fresh's existing ignore
+/// semantics. Unconditional fetch_sub would permit wraparound or double retire.
+fn subtract_shared(count: &AtomicU64, amount: u64, floor: u64) -> Result<bool> {
+    let mut observed = count.load(AtomicOrdering::Relaxed);
+    while observed >= floor {
+        let next = observed
+            .checked_sub(amount)
+            .ok_or("BPE fresh removal exceeds the current count")?;
+        match count.compare_exchange_weak(
+            observed,
+            next,
+            AtomicOrdering::Relaxed,
+            AtomicOrdering::Relaxed,
+        ) {
+            Ok(_) => return Ok(next < floor),
+            Err(actual) => observed = actual,
+        }
+    }
+    Ok(false)
+}
+
+/// Coalesce short buckets without splitting a complete key between tasks.
+/// The stable birth scatter preserves producer spatial order within each bucket.
+fn cold_ranges(events: &MergeEvents, route: &OwnerRoute, target: usize) -> Vec<Range<usize>> {
+    let mut ranges = Vec::new();
+    let mut begin = 0;
+    let mut cursor = 0;
+    while cursor < route.births.len() {
+        let reference = &route.changes[route.births[cursor]];
+        let bucket = events.chunks[reference.chunk].changes[reference.index()].bucket;
+        let length = route.births[cursor..].partition_point(|&index| {
+            let reference = &route.changes[index];
+            events.chunks[reference.chunk].changes[reference.index()].bucket == bucket
+        });
+        cursor += length;
+        if cursor - begin >= target {
+            ranges.push(begin..cursor);
+            begin = cursor;
+        }
+    }
+    if begin < cursor {
+        ranges.push(begin..cursor);
+    }
+    ranges
+}
+
+/// The original Fresh owner codec, with map/heap publication moved to the joined
+/// publish phase. A Fresh key belongs to exactly one rule/direction bucket.
+/// Complete-producer keys carry no birth-position events and cannot overlap it.
+fn build_cold<'a>(
+    events: &MergeEvents,
+    route: &OwnerRoute,
+    range: Range<usize>,
+    identities: usize,
+    execution: &Execution,
+    arena: &'a AllocationArena,
+    floor: u64,
+    direct: bool,
+) -> Result<Vec<(u64, PairState<'a>)>> {
+    struct BirthGroup {
+        weight: u64,
+        head: usize,
+        occurrences: usize,
+    }
+    impl Default for BirthGroup {
+        fn default() -> Self {
+            Self {
+                weight: 0,
+                head: usize::MAX,
+                occurrences: 0,
+            }
+        }
+    }
+    struct Fragment {
+        chunk: usize,
+        index: usize,
+        next: usize,
+    }
+
+    let worker = execution.current_worker();
+    let lease = arena.lease(worker);
+    let mut scratch = (!direct).then(|| execution.encoding(worker));
+    let mut directories = execution.directories();
+    let mut neighbors = IdAccumulator::<BirthGroup>::with_directory(
+        identities,
+        std::mem::take(&mut directories[0]),
+    );
+    let mut fragments = Vec::<Fragment>::new();
+    let mut completed = Vec::new();
+    let mut remaining = &route.births[range];
+    while let Some(&first_index) = remaining.first() {
+        let first_ref = &route.changes[first_index];
+        let first = &events.chunks[first_ref.chunk].changes[first_ref.index()];
+        let bucket = first.bucket;
+        let end = remaining.partition_point(|&index| {
+            let reference = &route.changes[index];
+            events.chunks[reference.chunk].changes[reference.index()].bucket == bucket
+        });
+        let (births, next) = remaining.split_at(end);
+        remaining = next;
+        let left = bucket & 1 == 0;
+        let pair = key_pair(first.born_key);
+        let replacement = if left { pair.1 } else { pair.0 };
+        for &reference_index in births {
+            let reference = &route.changes[reference_index];
+            let index = reference.index();
+            let change = &events.chunks[reference.chunk].changes[index];
+            let pair = key_pair(change.born_key);
+            let neighbor = if left { pair.0 } else { pair.1 };
+            let group = neighbors.touch(neighbor);
+            group.weight = group
+                .weight
+                .checked_add(change.born_weight)
+                .ok_or("BPE birth frequency exceeds u64")?;
+            group.occurrences = group
+                .occurrences
+                .checked_add(change.positions.len())
+                .ok_or("BPE birth position count exceeds resident bounds")?;
+            fragments.push(Fragment {
+                chunk: reference.chunk,
+                index,
+                next: group.head,
+            });
+            group.head = fragments.len() - 1;
+        }
+        for (neighbor, group) in neighbors.drain() {
+            if group.weight < floor {
+                continue;
+            }
+            let key = pair_key(if left {
+                (neighbor, replacement)
+            } else {
+                (replacement, neighbor)
+            });
+            let mut head = group.head;
+            let fragments = &fragments;
+            let sources = std::iter::from_fn(move || {
+                if head == usize::MAX {
+                    return None;
+                }
+                let fragment = &fragments[head];
+                head = fragment.next;
+                Some(fragment)
+            })
+            .map(|fragment| {
+                let chunk = &events.chunks[fragment.chunk];
+                (&chunk.chains, chunk.changes[fragment.index].positions)
+            });
+            let positions = if direct {
+                SortedPositions::from_reversed_iter_direct(
+                    group.occurrences,
+                    sources.flat_map(|(owner, chain)| owner.reversed(chain)),
+                    &lease,
+                )?
+            } else {
+                SortedPositions::from_reversed_iter(
+                    group.occurrences,
+                    sources.flat_map(|(owner, chain)| owner.reversed(chain)),
+                    scratch
+                        .as_deref_mut()
+                        .expect("buffered cold codec owns scratch"),
+                    &lease,
+                )?
+            };
+            debug_assert_eq!(positions.len(), group.occurrences);
+            completed.push((
+                key,
+                PairState {
+                    ledger_count_bits: group.weight.into(),
+                    positions,
+                },
+            ));
+        }
+        fragments.clear();
+    }
+    directories[0] = neighbors.into_directory();
+    Ok(completed)
+}
+
+impl<'a> PairIndex<'a> {
+    pub(super) fn commit_scatter(
+        &mut self,
+        events: &MergeEvents,
+        identities: usize,
+        execution: &Execution,
+        arena: &'a AllocationArena,
+        births: Vec<(u64, PairState<'a>)>,
+        diagnostic_round: Option<&super::super::single_producer_diagnostics::RoundDiagnostics>,
+    ) -> Result<()> {
+        debug_assert!(self.policy == IdentityPolicy::Fresh);
+        let floor = self.minimum_frequency.max(1);
+        let router = ShardRouter::new(self.shards.len(), self.fast_shard_router);
+        let mut routes = events.dispatch_births_with_router(router);
+        let cold_references: usize = routes.iter().map(|route| route.births.len()).sum();
+        let target = cold_references
+            .div_ceil(execution.workers() * 4)
+            .max(MIN_COLD_REFERENCES_PER_TASK);
+        let direct = self.direct_cold_encoding;
+        let shards = &self.shards;
+
+        // Relaxed atomics suffice for the numeric field: these tasks consume a
+        // fully published immutable index, and join precedes all structural writes
+        // and every subsequent exact-selection read. There is no concurrent drop.
+        let (retired, cold) = rayon::join(
+            || {
+                events
+                    .chunks
+                    .par_iter()
+                    .flat_map(|chunk| {
+                        chunk
+                            .changes
+                            .par_chunks(REMOVAL_RECORDS_PER_TASK)
+                            .map(|changes| {
+                                let mut retired = Vec::new();
+                                for change in changes {
+                                    if change.removed_weight == 0 {
+                                        continue;
+                                    }
+                                    let owner = router.owner(change.removed_key);
+                                    if let Some(state) =
+                                        shards[owner].states.get(&change.removed_key)
+                                    {
+                                        if subtract_shared(
+                                            &state.ledger_count_bits,
+                                            change.removed_weight,
+                                            floor,
+                                        )? {
+                                            retired.push((owner, change.removed_key));
+                                        }
+                                    }
+                                }
+                                Ok(retired)
+                            })
+                    })
+                    .collect::<Result<Vec<Vec<(usize, u64)>>>>()
+            },
+            || {
+                routes
+                    .par_iter_mut()
+                    .for_each(|route| route.group_births(events));
+                routes
+                    .par_iter()
+                    .enumerate()
+                    .flat_map(|(owner, route)| {
+                        cold_ranges(events, route, target)
+                            .into_par_iter()
+                            .map(move |range| {
+                                build_cold(
+                                    events, route, range, identities, execution, arena, floor,
+                                    direct,
+                                )
+                                .map(|states| (owner, states))
+                            })
+                    })
+                    .collect::<Result<Vec<_>>>()
+            },
+        );
+        // Both branches have joined even if either returned an error.
+        let retired = retired?;
+        let cold = cold?;
+        drop(routes);
+
+        let mut removals: Vec<Vec<u64>> = (0..self.shards.len()).map(|_| Vec::new()).collect();
+        for (owner, key) in retired.into_iter().flatten() {
+            removals[owner].push(key);
+        }
+        let mut completed: Vec<Vec<(u64, PairState<'a>)>> =
+            (0..self.shards.len()).map(|_| Vec::new()).collect();
+        let mut fast_keys = 0;
+        let mut fast_positions = 0;
+        for (key, state) in births {
+            if diagnostic_round.is_some() {
+                fast_keys += 1;
+                fast_positions += state.positions.len();
+            }
+            completed[router.owner(key)].push((key, state));
+        }
+        let mut cold_keys = 0;
+        let mut cold_positions = 0;
+        for (owner, states) in cold {
+            if diagnostic_round.is_some() {
+                cold_keys += states.len();
+                cold_positions += states
+                    .iter()
+                    .map(|(_, state)| state.positions.len())
+                    .sum::<usize>();
+            }
+            completed[owner].extend(states);
+        }
+        self.shards
+            .par_iter_mut()
+            .zip(removals.into_par_iter())
+            .zip(completed.into_par_iter())
+            .map(|((shard, retired), states)| -> Result<()> {
+                for key in retired {
+                    // Exactly one CAS crossed the floor. The map was frozen
+                    // throughout the shared phase, so the state is still present.
+                    let removed = shard
+                        .states
+                        .remove(&key)
+                        .ok_or("BPE scatter retirement lost its state")?;
+                    debug_assert!(removed.count() < floor);
+                }
+                for (key, state) in states {
+                    let priority = PairPriority {
+                        key,
+                        priority_count: state.count(),
+                    };
+                    if shard.states.insert(key, state).is_some() {
+                        return Err("BPE Fresh scatter birth overlaps an existing key".into());
+                    }
+                    shard.priorities.push(priority);
+                }
+                shard.prepare_prefix(floor);
+                Ok(())
+            })
+            .collect::<Result<Vec<_>>>()?;
+        if let Some(round) = diagnostic_round {
+            round.record_publication(cold_keys, cold_positions, fast_keys, fast_positions);
+        }
+        Ok(())
+    }
+}
